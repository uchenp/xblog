# 管理令牌（用于 API 认证）
# 生成方式: openssl rand -hex 32
ADMIN_TOKEN=your-secret-token-change-in-production

# 站点 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 站点作者（用于 SEO metadata）
NEXT_PUBLIC_SITE_AUTHOR=xblog

# Giscus 评论系统配置
# 访问 https://giscus.app/zh-CN 获取配置
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOxxxxxx
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOxxxxxx
